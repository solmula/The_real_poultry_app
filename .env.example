# ════════════════════════════════════════════════════════════════════════════════
# Firebase Admin SDK Credentials Configuration
# ════════════════════════════════════════════════════════════════════════════════
#
# IMPORTANT: This is an example file showing how to configure credentials.
#            DO NOT commit .env files to git (only .env.example should be tracked).
#
# Three methods are supported for seeding (listed in order of precedence):
#
# METHOD 1: GOOGLE_APPLICATION_CREDENTIALS (Recommended for CI/CD)
# ════════════════════════════════════════════════════════════════════════════════
# Point to a service account JSON file via environment variable.
# The JSON file is NOT committed to the repository.
#
#   Linux/macOS:
#     export GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
#     npm run seed
#
#   Windows (PowerShell):
#     $env:GOOGLE_APPLICATION_CREDENTIALS="C:\path\to\service-account-key.json"
#     npm run seed
#
#   Or add to .env (local development only):

GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# METHOD 2: Application Default Credentials (Recommended for local development)
# ════════════════════════════════════════════════════════════════════════════════
# Uses credentials from 'gcloud auth application-default login'
# No environment variables needed; the gcloud CLI handles it.
#
#   Setup once:
#     gcloud auth application-default login
#
#   Then run seeding without any environment variables:
#     npm run seed
#     dart scripts/seed_firestore.dart
#

# METHOD 3: Explicit service account path (Legacy — not recommended)
# ════════════════════════════════════════════════════════════════════════════════
# No longer supported in refactored scripts. Use METHOD 1 or 2 instead.

# ════════════════════════════════════════════════════════════════════════════════
# Firebase Project Configuration
# ════════════════════════════════════════════════════════════════════════════════
#
# Your Firebase project ID. If not set, defaults to 'poultry-automation-93ae1'.
# Override only if seeding a different project.

FIREBASE_PROJECT_ID=poultry-automation-93ae1

# ════════════════════════════════════════════════════════════════════════════════
# Setup Instructions
# ════════════════════════════════════════════════════════════════════════════════
#
# For local development (easiest):
#   1. Run: gcloud auth application-default login
#   2. npm run seed  (or dart scripts/seed_firestore.dart)
#   3. Done! No .env file needed.
#
# For CI/CD or environments where gcloud is not available:
#   1. Download a service account JSON key from Google Cloud Console:
#      - Go to: https://console.cloud.google.com/iam-admin/serviceaccounts
#      - Select: firebase-adminsdk-fbsvc@poultry-automation-93ae1.iam.gserviceaccount.com
#      - Click "Keys" tab → "Add Key" → "Create new key" → JSON
#      - Save as (NOT in git): /secure/path/service-account-key.json
#   2. Set: export GOOGLE_APPLICATION_CREDENTIALS="/secure/path/service-account-key.json"
#   3. npm run seed  (or dart scripts/seed_firestore.dart)
#
# For GitHub Actions or similar CI:
#   1. Add the service account JSON as a GitHub secret
#   2. In your workflow, write it to a file:
#        echo '${{ secrets.FIREBASE_SERVICE_ACCOUNT }}' > /tmp/sa-key.json
#   3. Set env var: GOOGLE_APPLICATION_CREDENTIALS=/tmp/sa-key.json
#   4. Run: npm run seed
#
# ════════════════════════════════════════════════════════════════════════════════
# Security Checklist
# ════════════════════════════════════════════════════════════════════════════════
#
# ✓ NEVER commit .env or service account JSON files to git
# ✓ NEVER hardcode credentials in source code
# ✓ ALWAYS use GOOGLE_APPLICATION_CREDENTIALS or gcloud CLI
# ✓ ALWAYS rotate service account keys regularly
# ✓ ALWAYS restrict service account permissions to minimum required
# ✓ ALWAYS remove old secrets from git history (git-filter-branch or BFG Repo-Cleaner)
# ✓ In .env: use absolute paths and ensure permissions are 600 (owner read/write only)
#
